# Database (direct connection for Drizzle Kit migrations only — not used at runtime)
DATABASE_MIGRATIONS_URL=

# Clerk
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=

# Hyperdrive local dev connection (binding: HYPERDRIVE)
# Used by wrangler dev / nuxt dev instead of localConnectionString in wrangler.jsonc
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Origin serving R2 media (binding: MEDIA, bucket: recipebean-media).
# Leave BLANK locally — images then serve from /api/media/<key> against the
# Miniflare R2 emulator. Production sets this via `vars` in wrangler.jsonc, not
# here, so the media host can change without a rebuild. Keep the key present
# and blank: `wrangler dev` (bun run preview) loads .env over wrangler.jsonc
# vars, which is what keeps a local preview on the Miniflare bucket too.
NUXT_PUBLIC_MEDIA_BASE_URL=
