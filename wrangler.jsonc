{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipebean",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "main": "./.output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "recipebean.app",
      "custom_domain": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f8f1a35c2ce14cd1bec19e912ebc4be7"
    }
  ]
}
